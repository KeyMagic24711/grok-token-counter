{
  "manifest_version": 3,
  "name": "Grok Token Counter",
  "version": "0.6.4",
  "description": "Grok weekly and Grok Bot weekly usage bars plus an approximate token count inside the grok.com chat box (unofficial).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://grok.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "src/content.js",
        "src/vendor/o200k_base.js",
        "src/badge.js"
      ],
      "css": [
        "src/hud.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "version_name": "0.6.4"
}
