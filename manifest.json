{
  "manifest_version": 3,
  "name": "Grok Token Counter",
  "version": "0.5.2",
  "description": "Thanh mức dùng Grok tuần & Grok Bot tuần ngay trong ô chat grok.com (không chính thức). Weekly Grok / Grok Bot usage bars inside the grok.com composer.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://grok.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/hud.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "version_name": "0.5.2"
}
